<header>
    <p>スケジュール管理アプリ</p>
</header>
<main>
<!--削除用モーダル  -->
<div class="modal" tabindex="-1" id="deleteModal" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">予定を削除しますか？</h5>
        <button type="button" class="btn-close" id="closeModal" aria-label="Close"></button> <!-- idを変更 -->
      </div>
      <div class="modal-body">
        <p>「<span id="post-title"></span>」を削除しますか？<br>この操作は取り消せません</p>
      </div>
      <div class="modal-footer">
        <!-- キャンセルボタン -->
        <button type="button" class="btn btn-secondary" id="cancelDeleteButton">キャンセル</button> <!-- idを変更 -->
        <button type="button" id="confirmDelete" class="btn btn-danger">削除</button>
      </div>
    </div>
  </div>
</div>


<div>
<span>予定一覧</span>
<span><%= link_to "新規追加", :new_post %></span>
</div>


<% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
<% end %>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>タイトル</th>
            <th>開始日</th>
            <th>終了日</th>
            <th>終日</th>
            <th>更新日</th>
            <th>参照</th>
            <th>編集</th>
            <th>削除</th>
        </tr>
    </thead>

    <tbody>
        <% @posts.each do |post| %>
            <tr>
                <td><%= post.id %></th>
                <td><%= post.title %></th>
                <td><%= post.start_date.to_s(:date_jp) %></th>
                <td><%= post.end_date.to_s(:date_jp) %></th>
                <td><%= post.all_day ? "○" : "" %></th>
                <td><%= post.updated_at.to_s(:datetime_jp) %></th>
                <td>
                    <%= link_to "参照", post %>
                </td>
                <td>
                    <%= link_to "編集", [:edit, post] %>
                </td>
                <td>
                    <%= link_to '削除', '#', class: 'open-delete-modal' , data: { post_id: post.id, post_title: post.title} %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
</main>
<footer>
    <h4>予定合計<%= @post_count %>件 </h4>
    <p>本日の日付<%= Date.today.to_s(:date_jp) %></p>
</footer>




