<header>
    <p>スケジュール管理アプリ</p>
</header>
<main>
<table>
    <caption>予定一覧</caption>
    <thead>
        <tr>
            <th>ID</th>
            <th>タイトル</th>
            <th>開始日</th>
            <th>終了日</th>
            <th>終日</th>
            <th>更新日</th>
            <th>参照</th>
            <th>編集</th>
            <th>削除</th>
        <tr>
    </thead>

    <tbody>
        <% @posts.each do |post| %>
            <tr>
                <td><%= post.id %></th>
                <td><%= post.title %></th>
                <td><%= post.start_date %></th>
                <td><%= post.end_date %></th>
                <td><%= post.all_day %></th>
                <td><%= post.updated_at.to_s(:datetime_jp) %></th>
                <td>
                    <%= link_to "参照", post %>
                </td>
                <td>
                    <%= link_to "編集", [:edit, post] %>
                </td>
                <td>
                    <%= link_to "削除", post_path(post), method: :delete %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
</main>
<footer>
    <h4>予定合計<%= @post_count %>件 </h4>
    <p>本日の日付<%= Date.today %></p>
</footer>




