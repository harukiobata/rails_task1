<h3>予定を編集して下さい</h3>
<% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
<% end %>
<%= form_with model: @post do |p| %>
    <table>
        <tr>
            <th><%= p.label :title ,"タイトル" %></th>
            <td><%= p.text_field :title  %>
            <%= render "shared/error_messages", obj: @post, attribute: :title %>
            </td>
        </tr>

        <tr>
            <th><%= p.label :start_date ,"開始日" %></th>
            <td><%= p.date_field :start_date,id: "start_date" %>
            <%= render "shared/error_messages", obj: @post, attribute: :start_date %>
            </td>
        </tr>

        <tr>
            <th><%= p.label :end_date ,"終了日" %></th>
            <td><%= p.date_field :end_date,id: "end_date" %>
            <%= render "shared/error_messages", obj: @post, attribute: :end_date %>
            </td>
        </tr>

        <tr>
            <th><%= p.label :all_day ,"終日の場合はチェックを入れて下さい" %></th>
            <td><%= p.check_box :all_day %></td>
        </tr>

        <tr>
            <th><%= p.label :schedule_memo ,"スケジュールメモ" %></th>
            <td><%= p.text_area :schedule_memo %>
            <%= render "shared/error_messages", obj: @post, attribute: :schedule_memo %>
            </td>
        <tr>
    </table>

    <div>
        <ul>
            <li><%= p.submit "編集を完了する" %></li>
            <li><%= link_to "予定一覧に戻る", :posts %></li>
        </ul>
    </div>
<% end %>